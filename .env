# ===========================================
# MiroFish - Configuracion de entorno
# ===========================================

# ===== LLM API Configuration (LongCat) =====
LLM_API_KEY=ak_2RQ1w851t2lx9JP0pW95Z0sW0qH0g
LLM_BASE_URL=https://api.longcat.ai/openai/v1
LLM_MODEL_NAME=LongCat-2.0

# ===== Graph Backend Configuration =====
# GRAPH_BACKEND=local usa el grafo local sobre MySQL/MariaDB (NO hay SQLite:
# el binario exige MySQL 8 / MariaDB).
# GRAPH_BACKEND=zep usa Zep Cloud (requiere ZEP_API_KEY de https://app.getzep.com/)
GRAPH_BACKEND=local

# ===== Base de datos (MySQL/MariaDB) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mirofish
DB_PASSWORD=rBJ6nt3KoqpUxyeYpcLHdVpqRWTkrpOe
DB_NAME=mirofish
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10

# ===== Seguridad / acceso =====
# Clave maestra de acceso (binario personal y respaldo admin del SaaS).
# Vacía = modo desarrollo abierto (solo para local).
# ACCESS_KEY=cambia_esto_por_una_clave_larga

# Firma de los tokens de sesión (JWT). Si se deja vacía se usa un default
# PUBLICO conocido: cámbiala en producción (p.ej. `openssl rand -hex 32`).
# SECRET_KEY=

# ===== Registro de logs =====
# debug | info (default) | warn | error
# LOG_LEVEL=info

# ===== Personalizables (opcional) =====
# OASIS_DEFAULT_MAX_ROUNDS=10
# REPORT_AGENT_MAX_TOOL_CALLS=8
# REPORT_AGENT_MAX_REFLECTION_ROUNDS=5
# REPORT_AGENT_TEMPERATURE=0.5
# MAX_CONTENT_LENGTH=52428800
# DEFAULT_CHUNK_SIZE=500
# DEFAULT_CHUNK_OVERLAP=50
