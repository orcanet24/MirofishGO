# MiroFish Personal SQLite — configuración mínima.
# Este .env va junto al ejecutable mirofish-personal-sqlite.exe.
#
# NO hace falta MySQL ni DB_DSN: todo se guarda en mirofish.db (SQLite) en
# esta misma carpeta (o MIROFISH_SQLITE_PATH si quieres otra ruta).
#
# LLM_API_KEY / LLM_BASE_URL / LLM_MODEL_NAME se pueden (y se recomienda)
# configurar desde la propia app: botón ⚙ Config abajo a la derecha — se
# guardan en SQLite y se aplican al momento, sin reiniciar. Si configuras
# aquí LLM_API_KEY la primera vez, se sembrará en SQLite al arrancar.

# Clave de acceso único (lo pide la web al entrar). Vacío = sin clave (dev).
ACCESS_KEY=

# Firma de las cookies/tokens. Cambia esto por un valor largo al azar.
SECRET_KEY=mirofish-secret-key

# Servidor HTTP
MIROFISH_HOST=127.0.0.1
MIROFISH_PORT=5001

# Ruta alternativa de la BD SQLite (opcional; por defecto ./mirofish.db)
# MIROFISH_SQLITE_PATH=C:\ruta\mirofish.db
